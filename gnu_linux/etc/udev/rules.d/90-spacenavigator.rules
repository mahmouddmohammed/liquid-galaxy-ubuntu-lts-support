# /etc/udev/rules.d/90-spacenavigator.rules
# Set up the SpaceNavigator to always have a symlink at /dev/input/spacenavigator

SUBSYSTEM=="input", ACTION=="add|bind", KERNEL=="event[0-9]*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c626", MODE="0664", GROUP="plugdev", SYMLINK+="input/spacenavigator"
SUBSYSTEM=="input", ACTION=="add|bind", KERNEL=="event[0-9]*", ATTRS{idVendor}=="256f", ATTRS{idProduct}=="c652", MODE="0664", GROUP="plugdev", SYMLINK+="input/spacenavigator"

SUBSYSTEM=="input", ACTION=="remove", ENV{ID_VENDOR_ID}=="046d", ENV{ID_MODEL_ID}=="c626", RUN+="/home/lg/bin/setup_virtualspacenavigator_symlink.sh"
SUBSYSTEM=="input", ACTION=="remove", ENV{ID_VENDOR_ID}=="256f", ENV{ID_MODEL_ID}=="c652", RUN+="/home/lg/bin/setup_virtualspacenavigator_symlink.sh"